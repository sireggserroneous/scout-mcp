 "recipes": [
  {
   "name": "mikrotik.com/specs",
   "about": "MikroTik product specs by model name",
   "input": "model",
   "examples": [
    "RB433AH",
    "hAP ac3",
    "CRS354-48G-4S+2Q+RM",
    "RB5009UG+S+IN",
    "CCR2004-1G-12S+2XS"
   ],
   "steps": [
    {
     "map": "https://mikrotik.com",
     "filter": "/product/",
     "same": [
      [
       "plus",
       ""
      ],
      [
       "[^a-z0-9]",
       ""
      ]
     ]
    },
    {
     "reach": "{url}",
     "want": "Specification"
    },
    {
     "extract": {
      "price": "^\\s*-\\s*Suggested price\\s*\\n\\s*(\\S.*)$",
      "cpu": "^\\s*-\\s*CPU\\s*\\n\\s*(\\S.*)$",
      "ram": "^\\s*-\\s*Size of RAM\\s*\\n\\s*(\\S.*)$",
      "max_power": "^\\s*-\\s*Max power consumption\\s*\\n\\s*(\\S.*)$"
     }
    }
   ]
  },
  {
   "name": "mikrotik.com/products",
   "about": "every MikroTik product page",
   "input": "",
   "examples": [
    ""
   ],
   "steps": [
    {
     "map": "https://mikrotik.com",
     "filter": "/product/"
    }
   ]
  },
  {
   "name": "amd.com/processor-specs",
   "about": "AMD processor specs by model name; read from the Wayback Machine while amd.com refuses Scout",
   "input": "model",
   "examples": [
    "Ryzen 9 9900X3D",
    "Ryzen 9 9950X3D",
    "EPYC 9575F",
    "EPYC 9965"
   ],
   "steps": [
    {
     "map": "https://www.amd.com/en/products/processors/",
     "filter": "\\.html$",
     "same": [
      [
       "\\.html$",
       ""
      ],
      [
       "^amd-",
       ""
      ],
      [
       "[^a-z0-9]",
       ""
      ]
     ]
    },
    {
     "reach": "{url}",
     "want": "General Specifications"
    },
    {
     "extract": {
      "cores": "^\\s*\\\\?# of CPU Cores\\s*\\n\\s*:\\s*(\\S.*)$",
      "threads": "^\\s*\\\\?# of Threads\\s*\\n\\s*:\\s*(\\S.*)$",
      "boost": "^\\s*Max\\. Boost Clock\\s*\\n\\s*:\\s*(\\S.*)$",
      "tdp": "^\\s*Default TDP\\s*\\n\\s*:\\s*(\\S.*)$",
      "launched": "^\\s*Launch Date\\s*\\n\\s*:\\s*(\\S.*)$",
      "socket?": "^\\s*CPU Socket\\s*\\n\\s*:\\s*(\\S.*)$"
     }
    }
   ]
  },
  {
   "name": "crucial.com/ssd",
   "about": "Crucial SSD name and price by SKU, from the page's schema.org data (read from the Wayback Machine while crucial.com refuses Scout)",
   "input": "sku",
   "examples": [
    "CT4000T705SSD5",
    "CT2000P3PSSD8",
    "CT1000T500SSD8"
   ],
   "steps": [
    {
     "map": "https://www.crucial.com/ssd/",
     "filter": "/ssd/[^/]+/ct\\w+$",
     "same": [
      [
       "[^a-z0-9]",
       ""
      ]
     ]
    },
    {
     "reach": "{url}"
    },
    {
     "jsonld": {
      "name": "name",
      "sku": "sku",
      "price": "offers.price",
      "currency?": "offers.priceCurrency"
     }
    }
   ]
  }
 ]
}